<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gemini HTML 보고서 제작 실전 마스터 가이드 (20대 핵심 기술)</title>
    <!-- Tailwind CSS 탑재 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <!-- Font Awesome 아이콘 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        lgred: {
                            50: '#FFF0F2',
                            100: '#FFE1E5',
                            500: '#C30D23', /* LG Signature Red */
                            600: '#A3071B',
                            700: '#820513',
                        },
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans KR', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', 'Noto Sans KR', sans-serif;
            background-color: #F8FAFC;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #F1F5F9;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            body {
                background-color: #ffffff !important;
            }
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- 글로벌 헤더 -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm no-print">
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-lgred-500 flex items-center justify-center text-white font-black text-xl shadow-md shadow-lgred-100">R</div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-slate-950 flex items-center gap-2">
                        HTML 실무 보고서 <span class="text-lgred-500">20대 인터랙티브 스킬</span> 마스터 가이드
                    </h1>
                    <p class="text-xs text-slate-500">임직원을 위한 2분할 대조형 시각화, 레이아웃 전환, 연산 및 유틸리티 종합 가이드</p>
                </div>
            </div>
            <div class="flex items-center gap-3 text-sm">
                <span class="px-3 py-1 bg-lgred-50 text-lgred-500 rounded-full font-semibold border border-lgred-100">실전 20대 스펙 스킬</span>
                <span class="text-slate-400">|</span>
                <span class="text-slate-600 font-medium">한 화면 2개 동시 대조 뷰</span>
            </div>
        </div>
    </header>

    <!-- 메인 레이아웃 분할 -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- 좌측 사이드바: 20대 보고 스킬 리스트 -->
        <aside class="lg:col-span-3 flex flex-col gap-4 no-print h-[calc(100vh-140px)] sticky top-[92px] overflow-y-auto pr-1">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <h2 class="text-xs font-bold text-slate-400 tracking-wider uppercase mb-4">전체 20가지 스킬 빠른 탐색</h2>
                <div class="space-y-1" id="skill-list-container">
                    <!-- 스킬 리스트 20종이 자바스크립트로 동적 렌더링됨 -->
                </div>
            </div>

            <!-- 미니 도움말 보드 -->
            <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white p-5 rounded-2xl shadow-lg relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-lgred-500 rounded-full opacity-20 blur-xl"></div>
                <h3 class="font-bold text-sm mb-1.5 relative z-10"><i class="fa-regular fa-lightbulb text-lgred-100 mr-2"></i>더블 캔버스 학습법</h3>
                <p class="text-[11px] text-slate-300 leading-relaxed relative z-10">
                    우측 대시보드에는 **상시 2개의 스킬**이 좌우로 배치됩니다. 각각의 프롬프트와 설계 요점을 비교하며 원하는 카드를 즉시 복사하여 사용하세요.
                </p>
            </div>
        </aside>

        <!-- 우측 메인 콘텐츠 영역 (2분할 카드 그리드) -->
        <section class="lg:col-span-9 flex flex-col gap-6">
            
            <!-- 현재 페이지 및 탐색 헤더 -->
            <div class="bg-white px-6 py-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-print">
                <div class="flex items-center gap-4">
                    <span id="current-page-badge" class="w-12 h-12 rounded-xl bg-lgred-500 text-white flex items-center justify-center font-bold text-lg shadow-sm">1</span>
                    <div>
                        <span class="text-xs text-lgred-500 font-bold">CURRENT DISPLAY PAGE</span>
                        <h3 class="text-base font-bold text-slate-900" id="current-page-title">스킬 복합 탐색 대시보드</h3>
                    </div>
                </div>
                <!-- 페이지네이션 제어 (총 10페이지, 페이지당 2개) -->
                <div class="flex items-center gap-2">
                    <button onclick="navigatePage(-1)" class="p-2 border border-slate-200 rounded-lg bg-white hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer" title="이전">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <span class="text-xs font-semibold text-slate-500 px-2" id="page-progress">PAGE 1 / 10</span>
                    <button onclick="navigatePage(1)" class="p-2 border border-slate-200 rounded-lg bg-white hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer" title="다음">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- 두 개의 스킬 카드가 활성화되는 그리드 공간 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="double-panel-container">
                <!-- 스킬 카드 두 개가 동적으로 인젝션됨 -->
            </div>

        </section>

    </main>

    <!-- 하단 푸터 -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-12 no-print">
        <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
            <p>© 2026 LG Active Red Style HTML Interactive Workshop Kit.</p>
            <div class="flex gap-4">
                <a href="#" class="hover:text-lgred-500 transition-colors">기획 가이드 원칙</a>
                <a href="#" class="hover:text-lgred-500 transition-colors">임직원 피드백 채널</a>
            </div>
        </div>
    </footer>

    <!-- 토스트 메시지 알림 -->
    <div id="toast-message" class="fixed bottom-6 right-6 bg-slate-900 text-white text-xs px-4 py-3 rounded-xl shadow-2xl border border-slate-800 flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none z-50">
        <i class="fa-solid fa-circle-check text-green-400"></i>
        <span id="toast-text">복사되었습니다!</span>
    </div>

    <script>
        // 20대 보고 스킬 정의
        const REPORT_SKILLS_DATA = [
            {
                id: 1,
                badge: "01",
                category: "Navigation & Layout",
