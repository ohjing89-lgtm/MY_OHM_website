        // 클립보드 문자 복사
        function copyPromptText(skillId) {
            const text = document.getElementById(`prompt-txt-source-${skillId}`).innerText;
            const dummy = document.createElement("textarea");
            dummy.value = text;
            document.body.appendChild(dummy);
            dummy.select();
            
            try {
                const ok = document.execCommand("copy");
                if (ok) {
                    // 복사 성공 딱지 노출
                    const btnText = document.getElementById(`copy-txt-${skillId}`);
                    const btnIcon = document.getElementById(`copy-icon-${skillId}`);
                    if (btnText && btnIcon) {
                        btnText.innerText = "완료";
                        btnIcon.className = "fa-solid fa-check text-green-400";
                        setTimeout(() => {
                            btnText.innerText = "복사";
                            btnIcon.className = "fa-regular fa-clone";
                        }, 2000);
                    }
                    showToastNotification("프롬프트 복사 성공! Gemini 캔버스에 붙여넣어 활용하세요.");
                }
            } catch (err) {
                showToastNotification("복사 실패. 수동 복사 부탁드립니다.");
            }
            document.body.removeChild(dummy);
        }

