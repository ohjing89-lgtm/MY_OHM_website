            text.innerText = msg;
            
            toast.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
            toast.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
            
            setTimeout(() => {
                toast.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
                toast.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
            }, 3000);
        }

        // ==========================================
        // 스킬 전용 백그라운드 엔진 동작 코드집
        // ==========================================

        // --- 1번 스킬: 가상 탭 페이지 제어 ---
        function s1_switchTab(tabId) {
            const tabs = document.querySelectorAll(".s1-tab");
            tabs.forEach(t => {
                t.className = "s1-tab px-3 py-1.5 border-b-2 border-transparent text-xs font-medium text-slate-500 hover:text-slate-800";
            });
            const pages = document.querySelectorAll(".s1-page");
            pages.forEach(p => p.classList.add("hidden"));

            const activeBtn = document.getElementById(`s1-btn-${tabId}`);
            if (activeBtn) activeBtn.className = "s1-tab px-3 py-1.5 border-b-2 border-lgred-500 text-xs font-bold text-lgred-500";
            
            const activePage = document.getElementById(`s1-page-${tabId}`);
            if (activePage) activePage.classList.remove("hidden");
        }

        // --- 2번 스킬: 아코디언 드롭 토글 ---
        function s2_toggle(idx) {
            const targetContent = document.getElementById(`s2-content-${idx}`);
            const targetIcon = document.getElementById(`s2-icon-${idx}`);
            if (!targetContent || !targetIcon) return;

            const isCurrentlyOpen = (targetContent.style.maxHeight !== '0px' && targetContent.style.maxHeight !== '');

            // 일괄 초기화
            [1, 2].forEach(i => {
                const c = document.getElementById(`s2-content-${i}`);
                const ic = document.getElementById(`s2-icon-${i}`);
                if (c) c.style.maxHeight = '0px';
                if (ic) ic.classList.remove("rotate-180");
            });

            if (!isCurrentlyOpen) {
                targetContent.style.maxHeight = '200px';
                targetIcon.classList.add("rotate-180");
            }
        }

        // --- 3번 스킬: 도넛 차트 업데이트 ---
        function s3_update(title, pct, desc) {
            document.getElementById("s3-dn-pct").innerText = pct;
            document.getElementById("s3-dn-lbl").innerText = title;
            document.getElementById("s3-dn-desc").innerText = desc;
        }
        function s3_reset() {
            document.getElementById("s3-dn-pct").innerText = "100%";
            document.getElementById("s3-dn-lbl").innerText = "전체 사용";
            document.getElementById("s3-dn-desc").innerText = "그래프 각 세그먼트에 마우스를 올려 상세 활용처를 탐색하세요.";
        }

        // --- 4번 스킬: 막대 갱신 셔플러 ---
        function s4_shuffle() {
            const v0 = Math.floor(Math.random() * 120) + 30;
            const v1 = Math.floor(Math.random() * 90) + 20;
            const v2 = Math.floor(Math.random() * 70) + 10;
            const max = Math.max(v0, v1, v2);

            document.getElementById("s4-bar-0").style.width = `${(v0/max)*100}%`;
            document.getElementById("s4-bar-1").style.width = `${(v1/max)*100}%`;
            document.getElementById("s4-bar-2").style.width = `${(v2/max)*100}%`;

            document.getElementById("s4-lbl-0").innerText = `${v0} h`;
            document.getElementById("s4-lbl-1").innerText = `${v1} h`;
            document.getElementById("s4-lbl-2").innerText = `${v2} h`;
        }

        // --- 5번 스킬: 2x2 매트릭스 노드 하이라이터 ---
        function s5_select(nodeId, title, coord, desc) {
            document.querySelectorAll(".s5-node").forEach(n => {
                n.classList.remove("ring-4", "ring-lgred-500", "scale-110");
            });
            const target = document.getElementById(`s5-${nodeId}`);
            if (target) target.classList.add("ring-4", "ring-lgred-500", "scale-110");

            document.getElementById("s5-box").innerHTML = `
                <h6 class="text-[10px] font-bold text-lgred-500">${title} (${coord})</h6>
                <p class="text-[9px] text-slate-600 mt-0.5 leading-normal">${desc}</p>
            `;
        }

        // --- 6번 스킬: 임시 컬러 스위처 ---
        function s6_theme(main, bg) {
            const wrap = document.getElementById("s6-wrapper");
            if (wrap) {
                wrap.style.setProperty('--s6-color', main);
                wrap.style.setProperty('--s6-bg', bg);
            }
        }

        // --- 7번 스킬: 반원 아크 게이지 충전기 ---
        function s7_set(pct) {
            const arc = document.getElementById("s7-arc");
            const lbl = document.getElementById("s7-val");
            if (!arc || !lbl) return;

            const val = 125.6 - (125.6 * (pct / 100));
            arc.style.strokeDashoffset = val;
            lbl.innerText = `${pct}%`;
        }

        // --- 8번 스킬: 임시 모달 개방 제어 ---
        function s8_open() {
            const m = document.getElementById("s8-modal");
            const c = document.getElementById("s8-card");
            if (m && c) {
                m.classList.remove("hidden");
                setTimeout(() => {
                    c.classList.remove("scale-95", "opacity-0");
                    c.classList.add("scale-100", "opacity-100");
                }, 50);
            }
        }
        function s8_close(e, force = false) {
            const m = document.getElementById("s8-modal");
            const c = document.getElementById("s8-card");
            if (e.target === m || force) {
                if (c) {
                    c.classList.remove("scale-100", "opacity-100");
                    c.classList.add("scale-95", "opacity-0");
                }
                setTimeout(() => {
                    if (m) m.classList.add("hidden");
                }, 200);
            }
        }

        // --- 9번 스킬: Before/After 비교 연산 ---
        function s9_calc() {
            const slider = document.getElementById("s9-slider");
            const b = document.getElementById("s9-before");
            const a = document.getElementById("s9-after");
            const banner = document.getElementById("s9-banner");

            if (!slider || !b || !a) return;
            const val = parseInt(slider.value);
            const remaining = 100 - val;

            b.style.width = `${remaining}%`;
            a.style.width = `${val}%`;

            document.getElementById("s9-val-before").innerText = `${(9.0 * (remaining/100)).toFixed(1)}h`;
            document.getElementById("s9-val-after").innerText = `${(1.5 * (val/100)).toFixed(1)}h`;

            if (val >= 75) {
                if (banner) banner.classList.remove("hidden");
            } else {
                if (banner) banner.classList.add("hidden");
            }
        }

        // --- 11번 스킬: 수평 연대기 마일스톤 노드 조율 ---
        function s11_step(idx, title, desc) {
            document.querySelectorAll(".s11-node").forEach(n => {
                n.className = "s11-node w-7 h-7 rounded-full bg-slate-300 text-slate-600 text-[10px] font-bold flex items-center justify-center cursor-pointer transition-all";
            });
            const target = document.getElementById(`s11-btn-${idx}`);
            if (target) target.className = "s11-node w-7 h-7 rounded-full bg-lgred-500 text-white text-[10px] font-bold flex items-center justify-center cursor-pointer transition-all";

            document.getElementById("s11-title").innerText = title;
            document.getElementById("s11-desc").innerText = desc;
        }

        // --- 12번 스킬: 데이터 리스트 테이블 필터 ---
        function s12_filter() {
            const val = document.getElementById("s12-search").value.toLowerCase();
            const rows = document.querySelectorAll("#s12-tbody tr");
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                if (text.includes(val)) {
                    r.style.display = "";
                } else {
                    r.style.display = "none";
                }
            });
        }

        // --- 13번 스킬: TOC 가상 스크롤바 ---
        function s13_scroll(el) {
            const progress = (el.scrollTop / (el.scrollHeight - el.clientHeight)) * 100;
            document.getElementById("s13-bar").style.width = `${progress}%`;

            // 스크롤 탑 기준 단락 활성
            const t1 = document.getElementById("s13-toc-1");
            const t2 = document.getElementById("s13-toc-2");
            const t3 = document.getElementById("s13-toc-3");

            t1.className = "border-l border-transparent pl-1";
            t2.className = "border-l border-transparent pl-1";
            t3.className = "border-l border-transparent pl-1";

            if (progress < 40) {
                t1.className = "text-lgred-500 border-l border-lgred-500 pl-1";
            } else if (progress < 80) {
                t2.className = "text-lgred-500 border-l border-lgred-500 pl-1";
            } else {
                t3.className = "text-lgred-500 border-l border-lgred-500 pl-1";
            }
        }

        // --- 14번 스킬: 우선 순위 카드 재배열 ---
        const MOCK_CARDS_DATA = [
            { title: "보안 필터 RAG", priority: 1, cost: 200, spec: "우선순위: 최고 / 비용: 중" },
            { title: "자동 이메일 기획", priority: 2, cost: 50, spec: "우선순위: 중간 / 비용: 최하" },
            { title: "사내 번역 연동봇", priority: 3, cost: 10, spec: "우선순위: 낮음 / 비용: 초소량" },
            { title: "통합 분석 에이전트", priority: 1, cost: 500, spec: "우선순위: 최고 / 비용: 높음" }
        ];
        function s14_sort(type) {
            const grid = document.getElementById("s14-grid");
            if (!grid) return;

            let sorted = [...MOCK_CARDS_DATA];
            if (type === 'prio') {
                sorted.sort((x, y) => x.priority - y.priority);
            } else {
                sorted.sort((x, y) => x.cost - y.cost);
            }

            grid.innerHTML = "";
            sorted.forEach(c => {
                grid.innerHTML += `
                    <div class="bg-slate-50 border border-slate-100 p-2 rounded-lg text-left">
                        <strong class="text-slate-950 font-bold block">${c.title}</strong>
                        <span class="text-[8px] text-slate-400 block mt-0.5">${c.spec}</span>
                    </div>
                `;
            });
        }

        // --- 15번 스킬: 리더보드 동적 순위 교환 ---
        let MOCK_RANKS = [
            { name: "LG 기획 관리 부문", score: 92 },
            { name: "DX 엔지니어링 본부", score: 88 },
            { name: "글로벌 영업 기획단", score: 75 }
        ];
        function s15_render() {
            const b = document.getElementById("s15-board");
            if (!b) return;

            MOCK_RANKS.sort((x, y) => y.score - x.score);
            b.innerHTML = "";
            MOCK_RANKS.forEach((r, idx) => {
                const colors = ['bg-lgred-500 text-white', 'bg-lgred-300 text-white', 'bg-slate-400 text-white'];
                b.innerHTML += `
                    <div class="flex items-center justify-between p-1.5 bg-slate-50 rounded-lg border border-slate-100 transition-all duration-300">
                        <div class="flex items-center gap-2">
                            <span class="w-4 h-4 rounded ${colors[idx] || 'bg-slate-200'} flex items-center justify-center font-bold text-[8px]">${idx + 1}</span>
                            <span class="font-bold text-slate-800">${r.name}</span>
                        </div>
                        <span class="font-black text-lgred-500">${r.score} 점</span>
                    </div>
                `;
            });
        }
        function s15_boost() {
            MOCK_RANKS[2].score += Math.floor(Math.random() * 10) + 12; // 3위 부서 가중치 부스트
            s15_render();
        }

        // --- 16번 스킬: ROI 환산 연산기 ---
        function s16_calc() {
            const head = parseInt(document.getElementById("s16-head").value) || 0;
            const hours = parseInt(document.getElementById("s16-hours").value) || 0;
            const priceUnit = 3000; // 시간당 기준 단가 가상 책정
            const annualSavings = head * hours * 52 * priceUnit;

            document.getElementById("s16-total").innerText = `₩ ${annualSavings.toLocaleString()}`;
        }

        // --- 17번 스킬: 체크박스 진척도 ---
        function s17_update() {
            const c1 = document.getElementById("s17-c1").checked;
            const c2 = document.getElementById("s17-c2").checked;
            const c3 = document.getElementById("s17-c3").checked;

            let score = 0;
            if (c1) score += 33.3;
            if (c2) score += 33.3;
            if (c3) score += 33.4;

            const pct = Math.round(score);
            document.getElementById("s17-pct").innerText = `${pct}%`;

            const arc = document.getElementById("s17-arc");
            if (arc) {
                // 251.2 원 둘레
                const offset = 251.2 - (251.2 * (pct / 100));
                arc.style.strokeDashoffset = offset;
            }
        }

        // --- 18번 스킬: 오버레이 툴팁 마우스 포인터 트랙킹 ---
        function s18_show(text) {
            const tip = document.getElementById("s18-tooltip");
            if (tip) {
                tip.innerText = text;
                tip.classList.remove("opacity-0", "pointer-events-none", "scale-95");
                tip.classList.add("opacity-100", "scale-100");
            }
        }
        function s18_hide() {
            const tip = document.getElementById("s18-tooltip");
            if (tip) {
                tip.classList.remove("opacity-100", "scale-100");
                tip.classList.add("opacity-0", "pointer-events-none", "scale-95");
            }
        }

        // --- 20번 스킬: 모의 드롭 드래그 로드 기조 ---
        function s20_over(e) {
            e.preventDefault();
            document.getElementById("s20-drop").className = "border-2 border-dashed border-lgred-500 rounded-xl p-3 bg-lgred-50 cursor-pointer transition-all";
        }
        function s20_leave() {
            document.getElementById("s20-drop").className = "border-2 border-dashed border-slate-300 rounded-xl p-3 bg-slate-50 cursor-pointer transition-all";
        }
        function s20_drop(e) {
            e.preventDefault();
            s20_triggerMock();
        }
        function s20_triggerMock() {
            s20_leave();
            const table = document.getElementById("s20-table-box");
            if (table) table.classList.remove("hidden");
            showToastNotification("사내 모의 데이터가 보안 컴파일러를 통과해 안전하게 하단 로드되었습니다!");
        }
    </script>
</body>
</html>
